# Where the fancontrol daemon is. In production: its unix socket, bind-mounted into the container.
FANCONTROL_SOCKET=/mnt/fancontrol/fancontrol.sock
# Development alternative (scripts/mock-daemon.mjs). Ignored when FANCONTROL_SOCKET is set.
# FANCONTROL_URL=http://127.0.0.1:5178

DATABASE_URL=postgres://fancontrol:fancontrol@127.0.0.1:5432/fancontrol

# The daemon publishes every 2s; history keeps one sample per this many seconds.
PERSIST_INTERVAL_SECONDS=10
# Raw samples older than this are dropped. 1-minute rollups are kept forever.
RAW_RETENTION_DAYS=7

# Optional push notifications for warnings and critical events (https://ntfy.sh or self-hosted).
# NTFY_URL=https://ntfy.sh/your-private-topic
