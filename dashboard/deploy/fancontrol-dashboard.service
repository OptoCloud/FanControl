[Unit]
Description=fancontrol dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=dashboard
WorkingDirectory=/opt/fancontrol-dashboard
EnvironmentFile=/etc/fancontrol-dashboard.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/node build
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
