# /etc/vigil-core.env
#
# Holds the database password, so this file is a secret: 0640 root:vigil, never in git.
#   install -o root -g vigil -m 0640 vigil-core.env /etc/vigil-core.env
#
# This is the role that OWNS the schema and writes every row. vigil-web gets its own
# read-only role instead; see docs/SECURITY.md §3.4.
VIGILD_SOCKET=/mnt/vigil/vigild.sock
DATABASE_URL=postgres://vigil:PASSWORD@10.0.0.130:5432/vigil
PERSIST_INTERVAL_SECONDS=10
RAW_RETENTION_DAYS=30
NUT_HOST=10.0.0.4
NUT_PORT=3493
NUT_UPS=apc
# NTFY_URL=https://ntfy.sh/your-private-topic

# Loopback. vigil-core refuses to start on any other address unless
# CORE_ALLOW_NON_LOOPBACK=1 is also set: actions are meant to arrive here, so nothing but
# vigil-web beside it may reach it (docs/SECURITY.md §1.1).
CORE_HOST=127.0.0.1
CORE_PORT=3001
