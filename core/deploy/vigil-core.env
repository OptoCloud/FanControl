# /etc/vigil-core.env
#
# Holds the database password, so this file is a secret: 0640 root:vigil, never in git.
#   install -o root -g vigil -m 0640 vigil-core.env /etc/vigil-core.env
#
# DATABASE_URL is the role that OWNS the schema and writes every row. The history and event
# log queries run as DATABASE_URL_READONLY, a SELECT-only role, so a bug in a query cannot
# write (docs/SECURITY.md §3.4 has the grant).
VIGILD_SOCKET=/mnt/vigil/vigild.sock
DATABASE_URL=postgres://vigil:PASSWORD@10.0.0.130:5432/vigil
DATABASE_URL_READONLY=postgres://vigil_web:PASSWORD@10.0.0.130:5432/vigil
PERSIST_INTERVAL_SECONDS=10
RAW_RETENTION_DAYS=30
NUT_HOST=10.0.0.4
NUT_PORT=3493
NUT_UPS=apc
# NTFY_URL=https://ntfy.sh/your-private-topic

# The dashboard, on the LAN with no authentication (docs/DECISIONS.md ADR-008). Port 3000,
# where vigil-web used to answer, so existing bookmarks keep working.
CORE_HOST=0.0.0.0
CORE_PORT=3000
