[Unit]
Description=vigil-core: reads vigild and the UPS, records history, raises alerts, serves the dashboard
After=network-online.target
Wants=network-online.target

[Service]
# sd_notify readiness comes from UseSystemd() in Program.cs, so "started" means listening.
Type=notify
# Needs read access to vigild's socket: its group must be the socket's (socket_gid in vigild.toml).
User=vigil
EnvironmentFile=/etc/vigil-core.env
# A self-contained single-file build (core/deploy/package.sh): no .NET runtime on the host.
ExecStart=/opt/vigil-core/vigil-core
Environment=WEB_ROOT=/opt/vigil-core/web
Restart=always
RestartSec=5

# Sandboxing. docs/SECURITY.md §3.3. vigil-core reads vigild's socket, upsd and Postgres,
# posts to ntfy, and serves the dashboard on the LAN (ADR-008). It writes nothing to disk and
# needs no privilege at all, so it takes all of it that .NET can run under.
NoNewPrivileges=true
# "strict", not "full". The socket directory is listed read-write because connecting to a
# unix socket wants write access to it, and with a leading "-" a missing bind mount does not
# stop the unit from starting (it retries the connection anyway).
ProtectSystem=strict
ReadWritePaths=-/mnt/vigil
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# vigild's socket (AF_UNIX); upsd, Postgres, ntfy and the dashboard (AF_INET/AF_INET6).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
# MemoryDenyWriteExecute: NOT set, .NET's JIT writes the machine code it then executes, so
# the process would not start. NativeAOT would allow it; moving to it is a tracked follow-up
# (docs/CLEANUP.md, ADR-016), and it puts this directive back.
# Runs as an unprivileged user and needs no capability whatsoever: it binds a port above
# 1024 and opens no device.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
