# vigil-core reads only its environment. For development against the stand-ins in dev/:
#   node dev/mock-vigild.mjs & node dev/mock-upsd.mjs &
#   docker compose -f dev/docker-compose.yml up -d
#   set -a; . core/.env; set +a; dotnet run --project core/Vigil.Core
# then `npm run dev` in web/, which proxies /api to this.
VIGILD_URL=http://127.0.0.1:5178
DATABASE_URL=postgres://vigil:vigil@127.0.0.1:5433/vigil
PERSIST_INTERVAL_SECONDS=2
NUT_HOST=127.0.0.1
# Loopback is enough while Vite serves the page in development.
CORE_HOST=127.0.0.1
