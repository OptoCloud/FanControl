# vigil-core reads only its environment. For development against the stand-ins in dev/:
#   node dev/mock-vigild.mjs & node dev/mock-upsd.mjs &
#   set -a; . core/.env; set +a; cargo run -p vigil-core
VIGILD_URL=http://127.0.0.1:5178
DATABASE_URL=postgres://vigil:vigil@127.0.0.1:5433/vigil
PERSIST_INTERVAL_SECONDS=2
NUT_HOST=127.0.0.1
