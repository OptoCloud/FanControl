<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Vigil.Core</RootNamespace>
    <UserSecretsId>vigil-core</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the tests can reach `internal` helpers whose behaviour matters but which are not
         part of this assembly's surface - URL parsing, the idle-timeout stream. -->
    <InternalsVisibleTo Include="Vigil.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The queries from core/sql/, embedded rather than copied: during the transition the Rust
         core still reads these same files with include_str!, so there is one home for the SQL
         (docs/STYLE.md §3.2). The DDL is not here - the Rust core still owns the schema until
         phase 6.7 moves it to EF Core migrations. -->
    <EmbeddedResource Include="../../core/sql/*.sql" LogicalName="Vigil.Core.Sql.%(Filename).sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- sd_notify readiness and the journald console format, both of which vigild has to do by
         hand in Rust. Microsoft's own package (docs/DECISIONS.md ADR-015). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="*" />
  </ItemGroup>

</Project>
