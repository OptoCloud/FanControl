<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>dotnet-FanControl.Daemon-e78d9023-3c37-4fc7-b489-6c9a5caee723</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FanControl.Core\FanControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships next to the binary so every deploy of publish/ carries the ExecStopPost script the unit expects. -->
    <None Include="../../deploy/release-fans.sh" Link="release-fans.sh" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
  </ItemGroup>
</Project>
