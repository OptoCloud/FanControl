# /etc/vigil-web.env
#
# Holds the database password, so this file is a secret: 0640 root:vigil, never in git.
#   install -o root -g vigil -m 0640 vigil-web.env /etc/vigil-web.env
#
# vigil_web is a SELECT-only role, not vigil-core's schema owner: vigil-web writes nothing,
# and the role is what enforces that rather than a comment. docs/SECURITY.md §3.4 has the
# grant, and the README's Deployment section has the one-time setup.
CORE_URL=http://127.0.0.1:3001
DATABASE_URL=postgres://vigil_web:PASSWORD@10.0.0.130:5432/vigil
