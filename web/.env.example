# Where vigild is. In production: its unix socket, bind-mounted into the container.
VIGILD_SOCKET=/mnt/vigil/vigild.sock
# Development alternative (scripts/mock-daemon.mjs). Ignored when VIGILD_SOCKET is set.
# VIGILD_URL=http://127.0.0.1:5178

DATABASE_URL=postgres://vigil:vigil@127.0.0.1:5432/vigil

# The daemon publishes every 2s; history keeps one sample per this many seconds.
PERSIST_INTERVAL_SECONDS=10
# Raw samples older than this are dropped. 1-minute rollups are kept forever.
RAW_RETENTION_DAYS=7

# NUT's upsd, for the UPS. Leave NUT_HOST unset to hide the UPS entirely.
# In development, scripts/mock-nut.mjs stands in for it on 127.0.0.1.
# NUT_HOST=127.0.0.1
NUT_PORT=3493
NUT_UPS=apc
NUT_POLL_SECONDS=5

# Optional push notifications for warnings and critical events (https://ntfy.sh or self-hosted).
# NTFY_URL=https://ntfy.sh/your-private-topic
